# Versions of tools that are not Go module dependencies (ADR-002).
#
# One home: Taskfile.yml reads this through dotenv and the workflows source it,
# so a local run and a CI run cannot disagree about which linter said the code
# was clean.
GOLANGCI_LINT_VERSION=v2.13.2
GOVULNCHECK_VERSION=v1.8.0
GORELEASER_VERSION=v2.18.2
GOWINRES_VERSION=v0.3.3
SYFT_VERSION=v1.54.1
# Task itself, which CI installs before it can run a task. Not TASK_VERSION,
# which Task sets to its own version.
GO_TASK_VERSION=v3.48.0
# The registry's publisher, which the release workflow downloads and verifies.
MCP_PUBLISHER_VERSION=v1.8.1
# The official bundle tool, and the Node that runs it, for checking a bundle.
MCPB_VERSION=2.1.2
NODE_VERSION=24.21.0
# Komac, which writes and submits the WinGet manifests for a release.
KOMAC_VERSION=v2.16.0
# Playwright, whose Chromium the browser tests drive as `mm-mcp login` finds it.
PLAYWRIGHT_VERSION=1.63.0
