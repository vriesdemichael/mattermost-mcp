*.log
.env
.env.*
*.exe

# The docs site's build output and its Python environment.
/site/
/docs/.venv/
__pycache__/

# Release build output.
/dist/
/RELEASE_NOTES.md

# Agent and task scratch space (ADR-018). Everything in it is disposable.
/.tmp/*
!/.tmp/.gitkeep

# Coverage measurements are computed per run, never committed (ADR-014).
/coverage.out
*.coverprofile

# Windows version resources go-winres generates for the release build.
cmd/mm-mcp/rsrc_windows_*.syso
