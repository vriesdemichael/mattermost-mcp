# Settings both live-test instances share. Each compose file names its own image,
# so Dependabot can propose each one's updates on its own terms (ADR-025).
#
# A disposable test instance: the credentials below are well known on purpose,
# and nothing here is fit for an instance anyone else can reach.
TZ=UTC
MM_SQLSETTINGS_DRIVERNAME=postgres
MM_SQLSETTINGS_DATASOURCE=postgres://mmuser:mmuser-password@postgres:5432/mattermost?sslmode=disable&connect_timeout=10
MM_SERVICESETTINGS_ENABLEUSERACCESSTOKENS=true
MM_SERVICESETTINGS_ENABLEBOTACCOUNTCREATION=true
MM_SERVICESETTINGS_ENABLEDEVELOPER=false
# The OAuth service, with clients registering themselves, which `mm-mcp login`
# uses where a server offers it (ADR-019).
MM_SERVICESETTINGS_ENABLEOAUTHSERVICEPROVIDER=true
MM_SERVICESETTINGS_ENABLEDYNAMICCLIENTREGISTRATION=true
MM_TEAMSETTINGS_ENABLEOPENSERVER=true
MM_TEAMSETTINGS_MAXUSERSPERTEAM=10000
MM_RATELIMITSETTINGS_ENABLE=false
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=false
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false
MM_LOGSETTINGS_CONSOLELEVEL=INFO
MM_PLUGINSETTINGS_ENABLEUPLOADS=false
MM_SERVICESETTINGS_ENABLESECURITYFIXALERT=false
MM_LOGSETTINGS_ENABLEDIAGNOSTICS=false
